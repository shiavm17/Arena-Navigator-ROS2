<?xml version="1.0" ?>
<!--
  obstacle_arena.world  -  custom 10 m x 10 m indoor arena for TurtleBot3 (Gazebo Classic 11)

  Coordinate frame (Gazebo world == map origin after SLAM starts at the spawn pose is NOT guaranteed,
  so spawn the robot at the same pose in mapping and navigation; default start = (-4.0, -4.0)).

  Layout (top view, metres, +x right, +y up):
    walls:       inner faces at x = +/-5.0, y = +/-5.0
    cylinder_1   (0.0, 0.0)  r=0.35         box_1 (-2.0,-2.0) 0.6x0.6      box_4 (-3.0, 2.0) 0.6x0.6
    triangle_1   (2.5, 3.0)  side 1.0       box_2 ( 1.5,-3.0) 0.8x0.5      box_5 ( 0.0, 2.8) 1.2x0.4
    half_wall    (1.8,-1.0)  1.6x0.2x0.5    box_3 ( 3.0, 0.0) 0.5x1.0      box_6 ( 4.0,-2.2) 0.6x0.6
  Floor markings (visual only): green = start (-4,-4); purple = goals A(3,-4) B(3.8,3.8) C(-3.5,3.5) D(0,-4) E(-3.5,0)
-->
<sdf version="1.6">
  <world name="obstacle_arena">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.85 0.9 0.95 1</background>
      <shadows>false</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -9.0 12.0 0 0.95 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
    <!-- ===== PERIMETER WALLS: inner arena 10 m x 10 m, walls 0.2 m thick, 1.0 m tall ===== -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5.1 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.4 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.4 0.2 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -5.1 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.4 0.2 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.4 0.2 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>5.1 0 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10.4 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10.4 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-5.1 0 0.5 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 10.4 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 10.4 1.0</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
    </model>    <!-- ===== RECTANGULAR OBSTACLES (x, y = centre in metres) ===== -->
    <model name="box_1">
      <static>true</static>
      <pose>-2.0 -2.0 0.4 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
      </link>
    </model>
    <model name="box_2">
      <static>true</static>
      <pose>1.5 -3.0 0.4 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.5 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.5 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
      </link>
    </model>
    <model name="box_3">
      <static>true</static>
      <pose>3.0 0.0 0.4 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 1.0 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 1.0 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
      </link>
    </model>
    <model name="box_4">
      <static>true</static>
      <pose>-3.0 2.0 0.4 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
      </link>
    </model>
    <model name="box_5">
      <static>true</static>
      <pose>0.0 2.8 0.4 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.4 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.4 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
      </link>
    </model>    <!-- Narrow passage: box_6 leaves a ~0.7 m gap to the east wall (inner face x = 5.0) -->
    <model name="box_6">
      <static>true</static>
      <pose>4.0 -2.2 0.4 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.8</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 0.8</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
      </link>
    </model>    <!-- ===== CYLINDRICAL OBSTACLE (r = 0.35 m) ===== -->
    <model name="cylinder_1">
      <static>true</static>
      <pose>0.0 0.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.35</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.35</radius><length>0.8</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
      </link>
    </model>    <!-- ===== TRIANGULAR OBSTACLE (equilateral prism, side 1.0 m) ===== -->
    <model name="triangle_1">
      <static>true</static>
      <pose>2.5 3.0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><polyline><point>-0.5000 -0.2887</point><point>0.5000 -0.2887</point><point>0.0000 0.5774</point><height>0.8</height></polyline></geometry></collision>
        <visual name="visual"><geometry><polyline><point>-0.5000 -0.2887</point><point>0.5000 -0.2887</point><point>0.0000 0.5774</point><height>0.8</height></polyline></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
      </link>
    </model>    <!-- ===== HALF-HEIGHT WALL: 0.5 m tall (perimeter walls are 1.0 m), 1.6 m long ===== -->
    <model name="half_wall">
      <static>true</static>
      <pose>1.8 -1.0 0.25 0 0 0.0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.6 0.2 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.6 0.2 0.5</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material></visual>
      </link>
    </model>    <!-- ===== FLOOR MARKINGS (visual only) ===== -->
    <model name="start_zone">
      <static>true</static>
      <pose>-4.0 -4.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>1.0 1.0 0.002</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Green</name></script></material></visual>
      </link>
    </model>
    <model name="goal_A">
      <static>true</static>
      <pose>3.0 -4.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.6 0.6 0.002</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Purple</name></script></material></visual>
      </link>
    </model>
    <model name="goal_B">
      <static>true</static>
      <pose>3.8 3.8 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.6 0.6 0.002</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Purple</name></script></material></visual>
      </link>
    </model>
    <model name="goal_C">
      <static>true</static>
      <pose>-3.5 3.5 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.6 0.6 0.002</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Purple</name></script></material></visual>
      </link>
    </model>
    <model name="goal_D">
      <static>true</static>
      <pose>0.0 -4.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.6 0.6 0.002</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Purple</name></script></material></visual>
      </link>
    </model>
    <model name="goal_E">
      <static>true</static>
      <pose>-3.5 0.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.6 0.6 0.002</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Purple</name></script></material></visual>
      </link>
    </model>

  </world>
</sdf>
